digraph BTree {
  graph [rankdir=TB, splines=line, nodesep=0.25, ranksep=0.6];
  node  [shape=record, fontname="Helvetica", fontsize=10];
  edge  [arrowsize=0.6];
  n3 [label="{ RRN 3 | { <a0>  | <a1> 25 | <a2> 35 } }"];
  n3:a0 -> n1;
  n3:a1 -> n2;
  n3:a2 -> n4;
  n1 [label="{ RRN 1 | { <a0>  | <a1> 6 | <a2> 23 } }"];
  n2 [label="{ RRN 2 | { <a0>  | <a1> 30 } }"];
  n4 [label="{ RRN 4 | { <a0>  | <a1> 36 } }"];
}
